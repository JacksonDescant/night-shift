# Dashboard settings (all optional; the dashboard also has a Settings dialog).
# Where the dashboard keeps connected repositories and tokens (owner-only permissions).
NIGHTSHIFT_DATA=~/.nightshift-dashboard
# The token the crew uses to post progress. Generated automatically if unset.
NIGHTSHIFT_TOKEN=
# The Watcher routine's webhook, and its Authorization header value.
NIGHTSHIFT_BOT_WEBHOOK=
NIGHTSHIFT_BOT_WEBHOOK_AUTH=
# 0 = never auto-merge; every fix waits for a human.
NIGHTSHIFT_AUTOMERGE=1
